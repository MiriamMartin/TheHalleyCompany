--- !u!114 &329598841
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 329598839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Stella,\r\n\nI\u2019m sorry. It was just us, but now it\u2019s going to
    be just you.\r\nThank you for staying with me, even when all we had was a scrappy
    shack. And when I couldn\u2019t come home from the office for days. And when
    you got sick and had to wait for me to save up enough for your medication.\r\nIt\u2019s
    funny\u2014 you kept me human, and you\u2019re not human yourself.\r\nI wish
    I didn\u2019t \nI wish I could\u2019ve \nYou never got to live\nTake care. You\u2019re
    a smart one. If nothing else, I have faith that you\u2019ll figure it out.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 030daa19a226c634ba99e1741e469c78, type: 2}
  m_sharedMaterial: {fileID: 382173469526622465, guid: 030daa19a226c634ba99e1741e469c78, type: 2}
